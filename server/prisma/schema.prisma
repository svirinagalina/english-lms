generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TEACHER
  STUDENT
}

model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Free-form transfer details shown only to signed-in students of this school.
  paymentDetails String?

  users     User[]
  lessons   Lesson[]
  units     Unit[]
  vocabSets VocabSet[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  // Per-student billing. Amount is in minor units (kopeks/cents) to avoid float rounding.
  priceAmount   Int?
  priceCurrency String  @default("RUB")
  paymentLink   String?
  paidUntil     DateTime?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  taughtLessons Lesson[]     @relation("TeacherLessons")
  enrollments   Enrollment[]
  attempts      Attempt[]
  cardReviews   CardReview[]

  @@index([schoolId])
}

model Lesson {
  id          String    @id @default(cuid())
  title       String
  scheduledAt DateTime?
  roomId      String    @unique @default(cuid())
  createdAt   DateTime  @default(now())

  teacherId String
  teacher   User   @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]
  board       Board?

  @@index([schoolId])
  @@index([teacherId])
}

model Board {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  // Whiteboard contents as an array of shapes. Stored as JSON so new shape
  // types can be added without a migration.
  elements Json @default("[]")

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

enum ExerciseType {
  TRANSLATE
  FILL_BLANK
  CHOICE
  WORD_ORDER
  MATCHING
}

// A chapter of the textbook: theory plus the exercises that drill it.
model Unit {
  id        String   @id @default(cuid())
  title     String
  theory    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  exercises Exercise[]

  @@index([schoolId])
}

model Exercise {
  id       String       @id @default(cuid())
  type     ExerciseType
  prompt   String
  position Int          @default(0)

  // Grammar topics such as "present-perfect" or "articles". When a student gets
  // this wrong, follow-up drills are pulled from exercises sharing a tag.
  tags String[] @default([])

  // Accepted answers. The first one is shown as the reference answer;
  // the rest are alternative phrasings that also count as correct.
  answers String[] @default([])

  // Type-specific payload: options for CHOICE, word list for WORD_ORDER,
  // pairs for MATCHING. Kept as JSON so new types need no migration.
  payload Json?

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  attempts Attempt[]

  @@index([unitId])
}

model Attempt {
  id        String   @id @default(cuid())
  answer    String
  correct   Boolean
  createdAt DateTime @default(now())

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([exerciseId])
}

model VocabSet {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  cards VocabCard[]

  @@index([schoolId])
}

model VocabCard {
  id      String  @id @default(cuid())
  term    String
  translation String
  example String?
  position Int    @default(0)

  setId String
  set   VocabSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  reviews CardReview[]

  @@index([setId])
}

// Spaced-repetition state, one row per student per card.
model CardReview {
  id         String   @id @default(cuid())
  streak     Int      @default(0)
  dueAt      DateTime @default(now())
  lastResult Boolean?

  cardId String
  card   VocabCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([cardId, studentId])
  @@index([studentId, dueAt])
}
