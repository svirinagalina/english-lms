generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TEACHER
  STUDENT
  // Works on the school's marketing content; sees only the Content section.
  PARTNER
}

model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  textbooks Textbook[]
  skillsets Skillset[]

  // Free-form transfer details shown only to signed-in students of this school.
  paymentDetails String?
  // Students who came through a trial lesson (a published trial report)
  // pay in roubles to this card instead; the euro link and note stay the
  // school's. JSON { card, cardNote }, null = same as paymentDetails.
  trialPaymentDetails String?

  users     User[]
  units      Unit[]
  vocabSets  VocabSet[]
  invites    Invite[]
  classrooms Classroom[]
  calls      Call[]
  contentItems ContentItem[]
  apiTokens    ApiToken[]
  leads        Lead[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  // A small profile picture, served from /uploads/avatars.
  avatar       String?
  // Personal details a person fills in on their own profile page; the
  // teacher sees a student's on the student's page.
  phone        String?
  messenger    String?  // Telegram / WhatsApp, as the person writes it
  birthday     String?  // YYYY-MM-DD
  city         String?
  timezone     String?  // IANA name, e.g. Europe/Moscow
  about        String?  // goals, interests — a few lines

  // Per-student billing. Amount is in minor units (kopeks/cents) to avoid float rounding.
  priceAmount   Int?
  priceCurrency String  @default("RUB")
  paymentLink   String?
  paidUntil     DateTime?

  // Lessons bought in the current package, and when that package started.
  // Sessions held after packageStartedAt count against lessonsPaid.
  lessonsPaid      Int?
  packageStartedAt DateTime?
  // Set by hand from the person page: added to the counted calls, so the
  // "held" number can be corrected (a lesson held elsewhere, a test call).
  heldAdjust       Int      @default(0)
  // When the student last pressed "I have paid" — the teacher confirms by hand.
  paymentReportedAt DateTime?
  // Which rouble card this student pays to: true = the after-trial card
  // (School.trialPaymentDetails), false = the school's own, null = decided
  // automatically (true once they have a published trial report).
  payToTrialCard Boolean?

  // Signed up by themselves (the app, /signup), no teacher yet: the free tier
  // — about 30% of grammar and vocabulary, the trainer's trial, a board to
  // try, no lessons. Linking them to a teacher (People) makes them a student
  // with everything. Invited students are never free.
  free             Boolean   @default(false)
  // A free user asked for a trial lesson; the owner is told.
  // A self-signed-up account confirms its email before the first sign-in
  // (a link in a letter). Invited and existing accounts count as confirmed.
  emailVerified    Boolean   @default(true)
  // Made for a lesson booked on the Advent site: signs in by its lesson link
  // (no password of its own until they set one with "Forgot password").
  viaLink          Boolean   @default(false)
  // After a trial booked on the Advent site: everything is open until then;
  // afterwards a lesson-link account must sign up (email + password) and,
  // without paid lessons, is on the free tier.
  trialAccessUntil DateTime?
  // The school's Telegram bot (telegram.js): the chat this person connected
  // with /start, and what the bot last saw of their package
  // ("lessonsPaid|packageStartedAt"), so a new payment is thanked once.
  telegramChatId   String?
  telegramName     String?
  telegramLinkedAt DateTime?
  telegramPaidSeen String?
  // Free time a teacher offers for trial lessons (booking.js).
  trialWindows     TrialWindow[]
  emailVerifications EmailVerification[]
  trialRequestedAt DateTime?
  trialRequestNote String?

  // A self-service subscription (see plans.js): 'practice' | 'calls' | 'all',
  // valid until planUntil. Paid through Stripe (planSource 'stripe') or
  // confirmed by hand for a card/rouble payment ('manual').
  plan                 String?
  planUntil            DateTime?
  planSource           String?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  attempts      Attempt[]
  cardReviews   CardReview[]
  teacherLinks  TeacherStudent[] @relation("TeacherLinks")
  studentLinks  TeacherStudent[] @relation("StudentLinks")
  sentInvites   Invite[]         @relation("SentInvites")
  teacherClassrooms Classroom[]  @relation("TeacherClassrooms")
  hostedCalls       Call[]       @relation("HostedCalls")
  studentClassrooms Classroom[]  @relation("StudentClassrooms")
  personalVocab     VocabSet[]   @relation("PersonalVocab")
  mistakes          LessonMistake[] @relation("StudentMistakes")
  passwordResets    PasswordReset[]
  contentItems      ContentItem[]
  apiTokens         ApiToken[]
  todos             UserTodo[]
  activity          ActivityDay[]
  lastSeenAt        DateTime?
  calendarEvents    UserCalendarEvent[]
  pushDevices       PushDevice[]

  @@index([schoolId])
}

// A phone that gets push notifications: the iOS app registers its APNs token
// after sign-in. A token Apple calls unregistered is deleted on the next send.
model PushDevice {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String   @default("ios")
  // A build run from Xcode gets tokens for Apple's sandbox, the App Store
  // build for production; learned on the first send.
  sandbox   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A request from a form on the public website (the IELTS page): kept here
// so it is never lost, and sent to the owners by email and push as well.
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  source    String
  name      String
  messenger String?
  email     String?
  comment   String?
  // Read from People → Website requests.
  handled   Boolean  @default(false)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

// A notification that must go out only once (a lesson reminder, an
// after-lesson note): its key is recorded when it is sent.
model PushSent {
  key       String   @id
  createdAt DateTime @default(now())
}




enum ExerciseType {
  TRANSLATE
  FILL_BLANK
  CHOICE
  WORD_ORDER
  MATCHING
}

// A chapter of the textbook: theory plus the exercises that drill it.
model Unit {
  id        String   @id @default(cuid())
  title     String
  theory    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  exercises Exercise[]

  @@index([schoolId])
}

model Exercise {
  id       String       @id @default(cuid())
  type     ExerciseType
  prompt   String
  position Int          @default(0)

  // Grammar topics such as "present-perfect" or "articles". When a student gets
  // this wrong, follow-up drills are pulled from exercises sharing a tag.
  tags String[] @default([])

  // Accepted answers. The first one is shown as the reference answer;
  // the rest are alternative phrasings that also count as correct.
  answers String[] @default([])

  // Type-specific payload: options for CHOICE, word list for WORD_ORDER,
  // pairs for MATCHING. Kept as JSON so new types need no migration.
  payload Json?

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  attempts Attempt[]

  @@index([unitId])
}

model Attempt {
  id        String   @id @default(cuid())
  answer    String
  correct   Boolean

  // Grammar topics the mistake was classified into; empty when correct.
  errorTopics String[] @default([])
  createdAt DateTime @default(now())

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([exerciseId])
}

model VocabSet {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // A personal set ("My words") belongs to one person and is seen by them alone;
  // a teacher's set (no owner) is for the whole school.
  ownerId String?
  owner   User?   @relation("PersonalVocab", fields: [ownerId], references: [id], onDelete: Cascade)

  cards VocabCard[]

  @@index([schoolId])
  @@index([ownerId])
}

model VocabCard {
  id      String  @id @default(cuid())
  term    String
  translation String
  example String?
  // Filled in for words saved from the dictionary: IPA and a pronunciation clip.
  transcription String?
  audio         String?
  position Int    @default(0)
  createdAt DateTime @default(now())

  setId String
  set   VocabSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  reviews CardReview[]

  @@index([setId])
}

// Spaced-repetition state, one row per student per card.
model CardReview {
  id         String   @id @default(cuid())
  streak     Int      @default(0)
  dueAt      DateTime @default(now())
  lastResult Boolean?

  cardId String
  card   VocabCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([cardId, studentId])
  @@index([studentId, dueAt])
}

// Links a student to the teacher whose lessons and materials they get.
// A student may study with more than one teacher.
model TeacherStudent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  teacherId String
  teacher   User   @relation("TeacherLinks", fields: [teacherId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([studentId])
}

// A pending invitation. The token goes into a link the inviter passes on;
// accepting it creates the account and, for students, the teacher link.
// "Forgot password": a single-use link, valid for an hour, mailed to the account.
model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  name      String
  role      Role
  createdAt DateTime  @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  // Inviting a student who already has an account from a trial lesson link:
  // accepting gives that account the email and password (board and history stay).
  userId     String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([email])
}

// The shared space between one teacher and one student: the call room,
// the boards they work on and the record of sessions held.
model Classroom {
  id        String   @id @default(cuid())
  roomId    String   @unique @default(cuid())
  createdAt DateTime @default(now())

  teacherId String
  teacher   User   @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)

  // Null means the teacher's own test room: same call and boards, no student,
  // so the call and whiteboard can be tried before anyone is invited.
  studentId String?
  student   User?   @relation("StudentClassrooms", fields: [studentId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sessions Session[]
  document Document?
  boards   Board[]
  // Boards that live elsewhere but are shared into this space as well.
  sharedBoards Board[] @relation("BoardShares")
  mistakes     LessonMistake[]
  trialReports TrialReport[]
  calls    Call[]

  @@unique([teacherId, studentId])
  @@index([schoolId])
}

// One call. Left open while somebody is in the room, closed when it empties.
// The mistake notebook: what the student said in a lesson and how it
// should be, classified into grammar topics for the analytics and drills.
model LessonMistake {
  id        String   @id @default(cuid())
  said      String
  correct   String
  topics    String[] @default([])
  // The drill task in Russian: a sentence whose natural translation is
  // exactly `correct`, with the context the tense needs ("уже два часа").
  prompt    String?
  createdAt DateTime @default(now())
  // Drilled in Practice: how many times the student got it right since.
  practicedCorrect Int       @default(0)
  lastPracticedAt  DateTime?
  // AI-made sentences on the same grammar point: [{ prompt, answer }], made once.
  similar          Json?

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation("StudentMistakes", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?
  // The note on the board it was written on, so deleting one deletes the other.
  boardId   String?
  elementId String?

  @@index([studentId, createdAt])
  @@index([classroomId])
}

// What a lesson was about, built when the call ends: topics, the words
// that came up, mistakes noted, and speaking questions for next time.
model LessonSummary {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classroomId String
  studentId   String
  topics      String[] @default([])
  // [{ word, transcription?, translation?, saved? }]
  words       Json     @default("[]")
  mistakeIds  String[] @default([])
  questions   String[] @default([])
  withAi      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classroomId, createdAt])
  @@index([studentId])
}

// A trial lesson: the placement test results as the teacher marked them,
// the teacher's assessment, and the generated report for the student.
model TrialReport {
  id          String   @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  teacherId   String
  callId      String?
  // { "1": "ok" | "partly" | "no", … }
  answers      Json     @default("{}")
  teacherLevel String?
  comments     String?
  // Grammar topics the teacher picked as the first to work on.
  focusTopics  String[] @default([])
  // The report: { level, plus, summary, strengths[], focus[], recommendations[], plan[], withAi }
  generated    Json?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([classroomId])
  @@index([studentId])
}

// Platform-wide settings kept out of the environment: the AI key (encrypted
// with the server secret), the provider and the model, set from the Settings page.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Session {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  note      String?
  summary   LessonSummary?

  // Lets a teacher exclude a session from the package count, e.g. a test call.
  counted Boolean @default(true)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, startedAt])
}

// A whiteboard kept as lesson material; a classroom accumulates many.
// One writing document per classroom: the student's text with the
// teacher's corrections kept as tracked changes (runs of base / ins / del).
model Document {
  id        String   @id @default(cuid())
  runs      Json     @default("[]")
  updatedAt DateTime @updatedAt

  classroomId String    @unique
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

model Board {
  id        String   @id @default(cuid())
  title     String   @default("Untitled")
  elements  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // A scratch board made for a call that has no student (a colleague or
  // group call): deleted when that call ends, never listed anywhere.
  scratch   Boolean  @default(false)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // One board can be attached to several students at once.
  sharedWith  Classroom[] @relation("BoardShares")
  // Calls started on this board: every student it is assigned to sees them.
  calls       Call[]

  @@index([classroomId, updatedAt])
}

// A call anyone can join by link — no account needed. Optionally tied to a
// classroom so it counts as a lesson for that student.
model Call {
  id        String    @id @default(cuid())
  token     String    @unique
  title     String?
  // LESSON, or TRIAL — a trial lesson's session does not use up paid lessons.
  kind      String    @default("LESSON")
  createdAt DateTime  @default(now())
  // When someone was last seen in the room (kept across server restarts).
  lastActiveAt DateTime?
  endedAt   DateTime?

  hostId String
  host   User   @relation("HostedCalls", fields: [hostId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  // The board the call was started on: each student that board is assigned
  // to gets "Join call" in their cabinet, even in a pair or group lesson.
  boardId String?
  board   Board?  @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@index([hostId, createdAt])
}

// --- Content pipeline: sources → editing → ready to publish ------------------

enum ContentStage {
  SOURCE
  EDITING
  READY
}

model ContentItem {
  id        String       @id @default(cuid())
  stage     ContentStage @default(SOURCE)
  title     String
  body      String?
  // Where it is meant for — one text often serves several places at once:
  // networks like "Instagram", "Telegram"; formats like "Post", "Story", "Reel".
  networks  String[]     @default([])
  formats   String[]     @default([])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // An edited or ready piece points back at the source it came from.
  sourceId String?
  source   ContentItem?  @relation("DerivedFrom", fields: [sourceId], references: [id], onDelete: SetNull)
  derived  ContentItem[] @relation("DerivedFrom")

  files ContentFile[]

  @@index([schoolId, stage, updatedAt])
}

model ContentFile {
  id        String   @id @default(cuid())
  name      String
  path      String
  mime      String
  size      Int
  createdAt DateTime @default(now())

  itemId String
  item   ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Personal token for the content API. Only the hash is stored; the token
// itself is shown once, when it is created.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A PDF textbook uploaded by a teacher: its pages are put on a board as
// pictures during a lesson, where they can be drawn and written on.
model Textbook {
  id         String   @id @default(cuid())
  title      String
  file       String   // path under the uploads folder (not served statically)
  bytes      Int      @default(0)
  pages      Int?
  createdAt  DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedById String?

  audio TextbookAudio[]

  @@index([schoolId])
}

// An audio track (e.g. a listening-test recording) attached to a textbook,
// so a teacher can open it alongside the book's pages during a lesson.
model TextbookAudio {
  id        String   @id @default(cuid())
  title     String
  file      String   // path under the uploads folder (not served statically)
  bytes     Int      @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  textbookId String
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  @@index([textbookId])
}

model UserTodo {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  dueDate   DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserCalendarEvent {
  id                String   @id @default(cuid())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  recurrence        String?  // null | "WEEKLY"
  recurrenceEndDate DateTime?  // When to stop repeating
  // The creator's IANA time zone: a weekly lesson repeats at the same local
  // time across daylight-saving changes (null = Europe/Madrid, the school's).
  timezone          String?
  studentIds        String[] @default([])  // JSON array of student IDs for group lessons
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Courses: self-paced learning modules (IELTS, FCE, etc) ------------------

model Skillset {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   // "IELTS", "FCE", "CAE", etc
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Course {
  id          String   @id @default(cuid())
  skillsetId  String
  title       String
  description String?
  lessons     CourseLesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skillset Skillset @relation(fields: [skillsetId], references: [id], onDelete: Cascade)

  @@index([skillsetId])
}

model CourseLesson {
  id        String   @id @default(cuid())
  courseId  String
  position  Int      // lesson order in course
  title     String
  type      String   @default("theory") // "theory", "practice", "supplementary"
  blocks    CourseLessonBlock[]
  exercises CourseExercise[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@index([courseId])
}

model CourseLessonBlock {
  id        String   @id @default(cuid())
  lessonId  String
  position  Int      // order within lesson
  type      String   // "text", "image", "video", "file", "html"
  // JSON payload: varies by type
  // text: { content: string }
  // image: { url: string, caption?: string }
  // video: { youtubeId: string } or { url: string, title?: string }
  // file: { url: string, name: string, mimeType?: string }
  // html: { html: string }
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model CourseExercise {
  id        String   @id @default(cuid())
  lessonId  String
  position  Int      // order within lesson
  type      String   // "MULTIPLE_CHOICE", "FILL_BLANK", "ESSAY", "MATCHING", "TRUE_FALSE"
  question  String
  // Answers/options are in payload as JSON:
  // MULTIPLE_CHOICE: { options: ["A", "B", "C", "D"], correctAnswer: "A" }
  // FILL_BLANK: { answer: string, alternatives?: [string] }
  // TRUE_FALSE: { correctAnswer: "true" | "false" }
  // ESSAY: { rubric?: string, sampleAnswer?: string }
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// A lesson booked on the Advent site (advent.js/adventLessons.js): Advent
// sends it by webhook, it lands in the teacher's Timetable, and once a call
// is started for it the platform reports back when it started, how it ended
// and — for a trial — the report.
model AdventLesson {
  id              String    @id @default(cuid())
  adventId        String    @unique
  kind            String    // trial | regular
  title           String
  topic           String?
  startsAt        DateTime
  durationMin     Int
  status          String    // scheduled | cancelled
  isTest          Boolean   @default(false)
  teacherId       String
  studentAdventId String?
  studentName     String?
  studentTelegram String?
  studentEmail    String?
  // Personal links (random) that let the student and the teacher in
  // without a password; the student's account made for this booking.
  studentToken    String?   @unique
  teacherToken    String?   @unique
  studentUserId   String?
  teacherNotifiedAt DateTime?
  // The student opened the waiting room (for "who didn't come").
  studentWaitingAt DateTime?
  calendarEventId String?
  callId          String?   @unique
  classroomId     String?
  teacherJoinedAt DateTime?
  teacherLeftAt   DateTime?
  studentJoinedAt DateTime?
  studentLeftAt   DateTime?
  startedSentAt   DateTime?
  finishedSentAt  DateTime?
  outcome         String?
  reportSentAt    DateTime?
  // The teacher pressed «Подтверждаю» in the bot.
  teacherConfirmedAt DateTime?
  // The time and teacher the bot last announced, so a move or a new teacher
  // is announced once.
  botStartsAt     DateTime?
  botTeacherId    String?
  // 'advent' = booked on Maxim's site (his API is told what happens);
  // 'platform' = booked on the platform's own /trial page (nobody else to tell).
  source          String    @default("advent")
  // Where a platform booking came from: utm_* and ref of the booking page.
  utm             Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([teacherId, startsAt])
}

// Free time a teacher offers for trial lessons: the /trial page cuts it into
// 40-minute lessons on the hour. Weekly windows repeat like Timetable lessons
// (generateRecurringInstances).
model TrialWindow {
  id                String    @id @default(cuid())
  teacherId         String
  teacher           User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  startTime         DateTime
  endTime           DateTime
  recurrence        String?   // null | "WEEKLY"
  recurrenceEndDate DateTime?
  timezone          String?
  createdAt         DateTime  @default(now())

  @@index([teacherId])
}

// Advent webhook events already handled, so a retry never creates a lesson twice.
model AdventEvent {
  id        String   @id
  lessonId  String?
  createdAt DateTime @default(now())
}

// A link sent at sign-up to confirm the address (see routes/auth.js).
model EmailVerification {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Which parts of the platform a person opened, per day (for the owner's
// activity view). One row per user, day and section; visits counts openings.
model ActivityDay {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String   // YYYY-MM-DD, UTC
  section String
  visits  Int      @default(1)
  lastAt  DateTime @default(now())

  @@id([userId, day, section])
  @@index([userId, lastAt])
}
